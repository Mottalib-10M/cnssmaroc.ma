---
import Layout from '../../components/layout/Layout.astro';
import { CONFIG } from '../../config';
import { buildBreadcrumbSchema } from '../../lib/seo';

const title = 'Actualites CNSS Maroc 2026 | Cotisations et reformes';
const description = 'Suivez les dernieres actualites CNSS au Maroc : nouveaux taux de cotisation, reformes de la protection sociale et changements reglementaires.';
const url = CONFIG.siteUrl + '/actualites/';

const articles = [
  {
    title: 'Cotisations CNSS 2026 : Ce qui change',
    desc: 'Analyse complete des modifications des taux de cotisation CNSS pour 2026, impact sur les salaries et les employeurs, et nouvelles dispositions reglementaires.',
    href: '/actualites/cotisations-cnss-2025/',
    tag: 'Cotisations',
    date: '2026-01-15',
  },
];

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Accueil', url: CONFIG.siteUrl + '/' },
    { name: 'Actualites', url },
  ]),
];
---

<Layout title={title} description={description} schema={schemas}>
  <section class="bg-gradient-to-br from-brand-600 to-brand-800 text-white py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <nav aria-label="Fil d'Ariane" class="mb-6">
        <ol class="flex flex-wrap items-center justify-center gap-1 text-sm text-brand-200">
          <li><a href="/" class="hover:text-white">Accueil</a></li>
          <li class="flex items-center gap-1"><span>/</span><span class="text-white font-medium">Actualites</span></li>
        </ol>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-bold leading-tight">
        Actualites CNSS et protection sociale
      </h1>
      <p class="mt-4 text-lg text-brand-100 max-w-2xl mx-auto">
        Les dernieres nouvelles sur les cotisations CNSS, les reformes de la protection sociale et les changements reglementaires au Maroc.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="space-y-6">
      {articles.map((article) => (
        <a href={article.href} class="group block bg-white rounded-2xl border border-gray-200 p-6 hover:border-brand-300 hover:shadow-md transition-all">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-block px-2.5 py-0.5 text-xs font-medium text-brand-700 bg-brand-50 rounded-full">{article.tag}</span>
            <span class="text-xs text-gray-400">{new Date(article.date).toLocaleDateString('fr-MA', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
          <h2 class="text-lg font-semibold text-gray-900 group-hover:text-brand-700 transition-colors">{article.title}</h2>
          <p class="mt-2 text-sm text-gray-600">{article.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
